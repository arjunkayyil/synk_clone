// Prisma schema for Synk-like task management app.
// Uses SQLite for local dev; switch provider to "postgresql" for production.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String      @id @default(cuid())
  name                 String
  email                String      @unique
  passwordHash         String
  resetToken           String?
  resetTokenExpiry     DateTime?
  tasks                Task[]      @relation("AssigneeTasks")
  timeEntries          TimeEntry[]
  comments             Comment[]

  @@map("users")
}

model Project {
  id    String @id @default(cuid())
  name  String
  key   String @unique
  tasks Task[]

  @@map("projects")
}

model Task {
  id          String      @id @default(cuid())
  projectId   String
  number      Int
  type        String
  priority    String
  title       String
  description String?
  status      String      @default("NEW")
  assigneeId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project     Project     @relation(fields: [projectId], references: [id])
  assignee    User?       @relation("AssigneeTasks", fields: [assigneeId], references: [id])
  timeEntries TimeEntry[]
  comments    Comment[]

  @@unique([projectId, number])
  @@map("tasks")
}

model TimeEntry {
  id      String    @id @default(cuid())
  taskId  String
  userId  String
  start   DateTime
  end     DateTime?

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("time_entries")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("comments")
}
